# Server config
HOST=0.0.0.0
PORT=3000

# Discord server widget
DISCORD_SERVER_ID=

# Discord presence (required for DiscordUser section)
DISCORD_USER_ID=
DISCORD_BOT_TOKEN=

# Steam (required for Steam section)
STEAM_API_KEY=
STEAM_ID=

# Overwatch (required for Overwatch section)
OVERWATCH_BATTLE_TAG=

# Twitch (required for the Twitch section). Create an app at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Last.fm (only for the Recently played section with service "lastfm"; ListenBrainz needs no key)
LASTFM_API_KEY=

# Admin panel (/admin). Leave both empty to disable the panel entirely.
# Generate the hash with `npm run admin:hash` — the password itself is then stored nowhere.
ADMIN_PASSWORD_HASH=
# Plain-text alternative, for local development only. Ignored when the hash is set.
ADMIN_PASSWORD=
# Optional: set to "public" to switch the admin panel off on this instance even if
# an admin password is set (for the public half of a two-container setup).
APP_ROLE=

# Optional: push notifications via ntfy for new contact messages, guestbook comments and
# game suggestions. Leave NTFY_TOPIC empty to switch it off. The visitors' text is sent to that server, and on
# public ntfy.sh anyone who knows the topic can read it: pick an unguessable topic or use a token.
# In the two-container setup this goes on the public instance (it receives them).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Access token for a protected topic (sent as "Authorization: Bearer ...").
NTFY_TOKEN=
# Link opened when the notification is tapped, e.g. https://example.com/admin
NTFY_CLICK=
# Which events to send, comma-separated: message, comment, suggestion. Empty = all.
NTFY_EVENTS=

# Optional: where runtime data (visitors.db) is stored (default: ./data)
DATA_DIR=

# Optional: visitor tracking salt
VISITOR_SALT=
