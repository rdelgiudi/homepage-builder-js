# Server config
HOST=0.0.0.0
PORT=3000

# Discord server widget
DISCORD_SERVER_ID=

# Discord presence (required for DiscordUser section)
DISCORD_USER_ID=
DISCORD_BOT_TOKEN=

# Steam (required for Steam section)
STEAM_API_KEY=
STEAM_ID=

# Overwatch (required for Overwatch section)
OVERWATCH_BATTLE_TAG=

# Admin panel (/admin). Leave both empty to disable the panel entirely.
# Generate the hash with `npm run admin:hash` — the password itself is then stored nowhere.
ADMIN_PASSWORD_HASH=
# Plain-text alternative, for local development only. Ignored when the hash is set.
ADMIN_PASSWORD=
# Optional: set to "public" to switch the admin panel off on this instance even if
# an admin password is set (for the public half of a two-container setup).
APP_ROLE=

# Optional: where runtime data (visitors.db) is stored (default: ./data)
DATA_DIR=

# Optional: visitor tracking salt
VISITOR_SALT=
