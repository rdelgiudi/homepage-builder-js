{
  "version": 2,
  "name": "Display Name",
  "tagline": "Your tagline or bio goes here",
  "favicon": "",
  "titleGradient": ["#60a5fa", "#a78bfa", "#f472b6", "#a78bfa", "#60a5fa"],
  "taglineGradient": [],
  "layout": {
    "site": "tabs"
  },
  "background": {
    "base": {
      "type": "solid",
      "light": "#f3f4f6",
      "dark": "#111827"
    },
    "effect": {
      "type": "comet"
    }
  },
  "effects": {
    "gradientBorders": true,
    "tabTransitions": true,
    "customScrollbar": true,
    "progressGradient": true,
    "progressGradientColors": ["#60a5fa", "#a78bfa", "#f472b6", "#a78bfa", "#60a5fa"],
    "widgetFrame": false,
    "widgetFrameWidth": 3,
    "mouseTrail": false,
    "mouseTrailColors": ["#60a5fa", "#a78bfa", "#f472b6", "#a78bfa", "#60a5fa"],
    "faviconAnimation": true,
    "reactionFlyer": true
  },
  "counters": {
    "viewers": true,
    "visitors": true
  },
  "tabs": [
    {
      "id": "welcome",
      "label": "Welcome",
      "icon": "👋",
      "sections": [
        {
          "id": "welcome-header",
          "type": "header",
          "title": "Hello! Welcome to my site!",
          "icon": "👋"
        },
        {
          "id": "welcome-text",
          "type": "text",
          "content": "A simple paragraph of text with an optional icon.",
          "icon": "💬"
        },
        {
          "id": "welcome-text-2",
          "type": "text",
          "content": "This one is left-aligned.",
          "align": "left"
        },
        {
          "id": "welcome-text-3",
          "type": "text",
          "content": "This one is right-aligned.",
          "align": "right"
        },
        {
          "id": "welcome-markdown",
          "type": "markdown",
          "file": "about.md"
        },
        {
          "id": "welcome-meme",
          "type": "meme",
          "icon": "",
          "text": "A random meme, refreshed each visit",
          "popular": false
        }
      ]
    },
