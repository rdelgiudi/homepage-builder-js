{
  "name": "custom-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node websocket-server.js",
    "build": "next build",
    "start": "node websocket-server.js",
    "lint": "eslint .",
    "admin:hash": "node scripts/admin-hash.js",
    "test": "node --test --import ./tests/register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/unit/**/*.test.ts\"",
    "test:integration": "next build && node --test --import ./tests/register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/integration/**/*.test.ts\""
  },
  "overrides": {
    "undici": "^6.29.1",
    "postcss": "$postcss"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.1",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.28.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "next": "^15.5.29",
    "quantize": "^1.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "ws": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
